# Project URL and publishable key.
# Dashboard → Connect, or Settings → API Keys → Publishable and secret API keys.
# The publishable key is safe in the browser. Never put the secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects can use the legacy anon key instead of a publishable key.
# VITE_SUPABASE_ANON_KEY=
